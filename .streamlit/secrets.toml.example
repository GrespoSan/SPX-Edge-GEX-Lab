# Documentation only; replace placeholders ONLY in Streamlit Cloud Secrets
# or in a local .streamlit/secrets.toml (ignored by Git).
# The offline upload mode requires none of these values.

# Option A: already-issued URL scoped to one private snapshot.
# SUPABASE_SNAPSHOT_SIGNED_URL = "https://PROJECT.supabase.co/storage/v1/object/sign/spx-snapshots/PATH.json.gz?token=REDACTED"

# Option B: an EXISTING identity with verified read-only privileges.
# Never use service_role, sb_secret_*, database or administrator credentials.
# SUPABASE_URL = "https://PROJECT.supabase.co"
# SUPABASE_ANON_KEY = "PUBLISHABLE_OR_ANON_KEY"
# SUPABASE_READ_TOKEN = "EXISTING_READ_ONLY_IDENTITY_JWT"
# SUPABASE_READ_ONLY_CONFIRMED = true
# This flag records the owner's review; it does not grant or restrict privileges.
# Do not modify existing Supabase policies or create an identity for this task.
