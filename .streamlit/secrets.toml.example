# Configurazione esclusiva dei Secrets dell'app Streamlit Edge GEX Lab.
# Copiare questo esempio nella schermata Streamlit Cloud > App settings > Secrets.
# NON inserire valori reali in GitHub, file del repository o chat.
#
# La pagina chiede SOLO EDGE_APP_PASSWORD. Le credenziali Supabase Edge
# (diverse dalla password dell'app) vengono usate sul server senza mostrarle.

# EDGE_APP_PASSWORD = "PASSWORD_LUNGA_E_UNICA_DA_DIGITARE_NELLA_PAGINA_EDGE"
#
# SUPABASE_URL = "https://PROJECT.supabase.co"
# SUPABASE_ANON_KEY = "PUBLISHABLE_OR_ANON_KEY"
# EDGE_READER_USER_ID = "UUID_DELL_UTENTE_SUPABASE_EDGE_GIA_ESISTENTE"
# EDGE_ARCHIVE_ENABLED = true
#
# EDGE_READER_EMAIL = "EMAIL_DELL_UTENTE_SUPABASE_EDGE_GIA_ESISTENTE"
# EDGE_READER_PASSWORD = "PASSWORD_DELL_UTENTE_SUPABASE_EDGE_GIA_ESISTENTE"

# Queste due credenziali sono limitate alla sola utenza Edge con policy SELECT.
# Non usare service_role, sb_secret_*, password database, token admin o URL firmati.
# L'app NON modifica bucket, policy, snapshots, calcoli Serafini o MT4.
