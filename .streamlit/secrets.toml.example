# Initial configuration for the private automatic archive.
# Copy ONLY into the Edge app's Streamlit Cloud Secrets or local secrets.toml.
# The public upload/demo modes need no credentials.
# The dedicated reader must be created and granted scoped SELECT first.
# Never configure service_role, sb_secret_*, database passwords or Auth passwords.

# SUPABASE_URL = "https://PROJECT.supabase.co"
# SUPABASE_ANON_KEY = "PUBLISHABLE_OR_ANON_KEY"
# EDGE_READER_USER_ID = "UUID_OF_THE_DEDICATED_EDGE_AUTH_USER"
# EDGE_ARCHIVE_ENABLED = true

# Users enter the dedicated Edge email/password in the app login form.
# Tokens stay in that user's server session and are refreshed automatically.
# Old server-side SUPABASE_READ_TOKEN / signed-URL settings are not used by the UI.
